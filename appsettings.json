{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Forwarder": {
    "TargetBaseUri": "https://httpbin.org",
    "CustomHopByHopHeaders": [
      "X-Internal-Secret",
      "X-Custom-Trace"
    ]
  },
  "Chaos": {
    "Enabled": true,
    "LatencyProbability": 0.50,
    "LatencyMinMs": 1000,
    "LatencyMaxMs": 2500,
    "FaultProbability": 0.25,
    "FaultStatusCode": 500,
    "AbortProbability": 0.1
  },
  "CircuitBreaker": {
    "Enabled": true,
    "FailureThreshold": 3,
    "BreakDurationSeconds": 10
  },
  "RateLimiter": {
    "Capacity": 10,
    "TokensPerSecond": 1,
    "BucketIdleTimeoutMinutes": 10
  }
}
